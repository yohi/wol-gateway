# Fixed target. Do not make this user-controlled.
WOL_MAC=AA:BB:CC:DD:EE:FF

# Prefer the LAN subnet's directed broadcast, e.g. 192.168.1.255.
WOL_BROADCAST=192.168.1.255
WOL_PORT=9

# Prevent accidental repeated wake requests.
WOL_MIN_INTERVAL_SECONDS=30

# Requires requests routed through Cloudflare Access.
# /health remains local-health-check friendly.
REQUIRE_CF_ACCESS=true

LOG_LEVEL=INFO

# Remotely managed Cloudflare Tunnel token.
CLOUDFLARE_TUNNEL_TOKEN=replace-me
