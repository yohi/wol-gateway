# Fixed Wake-on-LAN target: AI agent PC.
WOL_MAC=AA:BB:CC:DD:EE:FF
WOL_BROADCAST=192.168.1.255
WOL_PORT=9

# AI agent PC reachability probe.
AI_AGENT_HOST=192.168.1.20
AI_AGENT_PORT=22
AI_AGENT_PROBE_TIMEOUT_SECONDS=0.8

# Prevent accidental repeated wake requests.
WOL_MIN_INTERVAL_SECONDS=30

# Worker -> gateway relay authentication. Replace with a long random secret.
WOL_RELAY_SHARED_SECRET=replace-with-random-secret

LOG_LEVEL=INFO
